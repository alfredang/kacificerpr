# LOCAL DEVELOPMENT ONLY - committed deliberately so a fresh clone runs
# `pnpm db:local:up && pnpm db:migrate && pnpm db:seed && pnpm dev` with zero setup.
# DATABASE_URL is the Docker Postgres from docker-compose.yml; AUTH_SECRET,
# APP_ENCRYPTION_KEY and CRON_SECRET are throwaway dev keys; emails stay in
# /dev/mailbox and third parties are mocked. NEVER reuse these values in
# production. Real API keys (DeepSeek, Asana, Resend, Telegram) belong in Vercel
# env vars or Settings -> Integrations, not in a committed file.

# ---- Database -------------------------------------------------------------
# Local Docker Postgres (pnpm db:local:up) — driver auto-selects `pg`:
DATABASE_URL=postgresql://kacific:kacific@localhost:5433/kacific_erp
# Neon (driver auto-selects neon-serverless when host ends in .neon.tech):
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/kacific_erp?sslmode=require
# Force a driver: pg | neon
# DB_DRIVER=pg

# ---- App secrets (openssl rand -base64 32) --------------------------------
AUTH_SECRET=qCZUW+F0qQ1ic+FxmSyHVFRnyo+R43Cp0UDhzWueY0k=
APP_ENCRYPTION_KEY=Lr4lWWUSbcGutuBupgDP5lKtxvc3XTel0Q6WhajbzU8=
CRON_SECRET=b35b0aa6abf2d262622767b61f7af21f6470f08b46d57823
APP_URL=http://localhost:3000

# ---- Email (Resend). EMAIL_TRANSPORT: resend | console | outbox ------------
EMAIL_TRANSPORT=outbox
RESEND_API_KEY=
EMAIL_FROM="Kacific ERP <erp@example.com>"

# ---- Integrations (can also be set in Settings → Integrations, encrypted) --
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ASANA_PAT=
ASANA_WORKSPACE_GID=
ASANA_PROJECT_GID=

# ---- Test switches --------------------------------------------------------
# INTEGRATIONS_MOCK=1   # stub Asana/Resend/DeepSeek network calls in-process
# AI_MOCK=1             # canned DeepSeek responses for e2e

# local dev/e2e: stub third parties (remove when real keys are added)
INTEGRATIONS_MOCK=1
AI_MOCK=1
LOGIN_RATE_LIMIT=200
