# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the templates, drop the real env files
!.env.example
!.env.docker.example

# local agent tooling and test output (.claude/ and .mcp.json ARE committed)
.claude/settings.local.json
.playwright-mcp/
/test-results/
/playwright-report/
/tests/e2e/.auth/
skills-lock.json

# .env.local is committed ON PURPOSE (local-dev-only values) so the prototype
# reproduces from a clone. Real API keys go in Vercel env / Settings -> Integrations.
!.env.local

# Distribution archives (rebuildable — never pushed to GitHub)
*.zip
# Source material the project was derived from — not ours to republish.
**/reference/
