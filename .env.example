# ---- Database -------------------------------------------------------------
# Local Docker Postgres (pnpm db:local:up) — driver auto-selects `pg`:
DATABASE_URL=postgresql://kacific:kacific@localhost:5433/kacific_erp
# Neon (driver auto-selects neon-serverless when host ends in .neon.tech):
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/kacific_erp?sslmode=require
# Force a driver: pg | neon
# DB_DRIVER=pg

# ---- App secrets (openssl rand -base64 32) --------------------------------
AUTH_SECRET=change-me-32-bytes-base64
APP_ENCRYPTION_KEY=change-me-32-bytes-base64
CRON_SECRET=change-me
APP_URL=http://localhost:3000

# ---- Email (Resend). EMAIL_TRANSPORT: resend | console | outbox ------------
EMAIL_TRANSPORT=outbox
RESEND_API_KEY=
EMAIL_FROM="Kacific ERP <erp@example.com>"

# ---- Integrations (can also be set in Settings → Integrations, encrypted) --
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
ASANA_PAT=
ASANA_WORKSPACE_GID=
ASANA_PROJECT_GID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ---- Test switches --------------------------------------------------------
# LOGIN_RATE_LIMIT=200  # relax the 5-per-15-min login limit for e2e runs
# INTEGRATIONS_MOCK=1   # stub Asana/Resend/DeepSeek network calls in-process
# AI_MOCK=1             # canned DeepSeek responses for e2e
