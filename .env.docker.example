# Copy to .env.docker for `docker compose --profile app up`. DATABASE_URL is set by compose.
AUTH_SECRET=change-me-32-bytes-base64
APP_ENCRYPTION_KEY=change-me-32-bytes-base64
CRON_SECRET=change-me
APP_URL=http://localhost:3000
# Email is controlled in-app at Settings → Integrations (enable Resend + a key
# there to send for real); until then everything lands in /dev/mailbox. This
# RESEND_API_KEY is only a fallback default if no key is saved in Settings.
RESEND_API_KEY=
EMAIL_FROM="Kacific ERP <erp@example.com>"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
ASANA_PAT=
ASANA_WORKSPACE_GID=
ASANA_PROJECT_GID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
